<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Плеер в фоне и с заблокированным экраном (служба переднего плана Media3). Медиауведомлению
         POST_NOTIFICATIONS не нужно: Android 13+ делает исключение для медиасессий. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />

    <!-- Резервная копия Google (решение 5, docs/android/08, 2026-10-05): только файл настроек и прогресса
         DataStore — отметки хадисов, счётчики, палитра переживают смену телефона, как iCloud-копия на iOS. -->
    <application
        android:name=".app.InabahApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Inabah">

        <!-- Запуск из лаунчера — только через алиасы ниже; сама активность открывается явными интентами
             (уведомление плеера). -->
        <activity
            android:name=".app.MainActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Inabah.Starting" />

        <!-- Смена иконки (этап 9, docs/android/08): по алиасу на вариант, включён ровно один — его значок
             в лаунчере и на заставке. Имена — AppIconOption.aliasName; переключает PackageManagerAppIconSwitcher. -->
        <activity-alias
            android:name=".app.IconClassic"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".app.IconNiche"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_niche"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".app.IconBeads"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_beads"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".app.IconDawn"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_dawn"
            android:targetActivity=".app.MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Экспортирована: к сессии подключаются системные контроллеры (уведомление, экран блокировки,
             Bluetooth) — разрешением их не ограничить (ExportedService). Посторонние приложения
             отклоняет PlaybackService.SessionCallback.onConnect, записи — только из ассетов. -->
        <service
            android:name=".core.audio.PlaybackService"
            android:exported="true"
            android:foregroundServiceType="mediaPlayback"
            tools:ignore="ExportedService">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>
    </application>

</manifest>
