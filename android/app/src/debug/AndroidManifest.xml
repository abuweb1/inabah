<?xml version="1.0" encoding="utf-8"?>
<!-- Только debug-сборка, в release этого нет. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <!-- Каталог компонентов дизайн-системы для сверки с iOS по снимкам. exported — чтобы запускать
             через adb (am start); фильтров намерений нет. -->
        <activity
            android:name=".designcatalog.DesignCatalogActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Inabah"
            tools:ignore="LockedOrientationActivity,DiscouragedApi" />
    </application>
</manifest>
