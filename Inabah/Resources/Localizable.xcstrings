    "hadith.home.epigraph.source" : {
      "comment" : "Главная хадисов: источник хадиса о наследии пророков (мелким шрифтом)",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "имам Ахмад (21716), Абу Дауд (3641), ат-Тирмизи (2682)"
          }
        }
      }
    },
    "hadith.home.epigraph.text" : {
      "comment" : "Главная хадисов: хадис о наследии пророков под подзаголовком",
      "localizations" : {
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Пророки не оставляли в наследство ни динаров, ни дирхемов, но они оставляли в наследство знание…»"
          }
        }
      }
    },
    "hadith.home.verse.reference" : {
      "comment" : "Источник хадиса на главной раздела хадисов",
