<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Дополняет сгенерированный Info.plist (GENERATE_INFOPLIST_FILE = YES) ключами,
     которых нет среди INFOPLIST_KEY_* в настройках сборки. -->
<plist version="1.0">
<dict>
	<!-- Только стандартное шифрование системы (HTTPS не используется вовсе) — App Store Connect
	     не спрашивает про экспорт криптографии при каждой загрузке. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- Фоновый звук: «Прослушать все» продолжает играть на заблокированном экране (свои записи — 2026-10-12). -->
	<!-- «Къибла»: только пока экран открыт; перевод на другие языки — InfoPlist.xcstrings. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Чтобы рассчитать направление на Каабу, нужно знать, где вы находитесь. Координаты остаются на телефоне и никуда не отправляются.</string>
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
