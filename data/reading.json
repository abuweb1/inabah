          "title": "Буквы",
          "subtitle": "имена букв"
        }
      },
      "blocks": [
        {
          "type": "text",
          "translations": {
            "ru": {
              "text": "В арабском пишут и читают справа налево. Нажмите на букву, чтобы узнать её название."
            }
          }
        },
        {
          "type": "letters"
        }
