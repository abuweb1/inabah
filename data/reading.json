          "arabic": "حُرُوفُ الاسْتِعْلَاءِ",
          "letters": [
            "ط",
            "ظ",
            "ض",
            "ص",
            "غ",
            "خ",
            "ق"
          ],
          "translations": {
            "ru": {
              "translit": "хуруфу-льистиӏльа",
              "text": "Ниже 7 букв, которые читаются твёрдо: с фатхьой - с оттенком «о». А 4 (ط ظ ض ص) из них с касрой - с оттенком «ы»."
            }
          }
        },
        {
          "type": "rule",
          "arabic": "تَفْخِيمُ الرَّاءِ وَتَرْقِيقُهَا",
          "letters": [
            "ر"
          ],
          "translations": {
            "ru": {
              "translit": "тафхииму-ррооъи ва таркъиикъухаа",
              "text": "Ро не твердая буква, но с фатхьой всегда твердо с оттенком на «о»."
            }
          }
        }
